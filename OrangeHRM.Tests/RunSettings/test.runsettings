<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <ResultsDirectory>../TestResults</ResultsDirectory>
  </RunConfiguration>
  <LoggerRunSettings>
    <Loggers>
      <Logger friendlyName="trx" enabled="true" />
    </Loggers>
  </LoggerRunSettings>
  <!-- Run sequentially against the shared public demo. -->
  <NUnit>
    <NumberOfTestWorkers>0</NumberOfTestWorkers>
  </NUnit>
  <Playwright>
    <BrowserName>chromium</BrowserName>
    <ExpectTimeout>15000</ExpectTimeout>
    <LaunchOptions>
      <!-- Show the browser locally; override to true on the command line for headless runs. -->
      <Headless>false</Headless>
    </LaunchOptions>
  </Playwright>
</RunSettings>
